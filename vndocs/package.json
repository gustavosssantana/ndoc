{
  "name": "ndocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Template .docx + planilha .xlsx -> lote de documentos em .zip",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "samples": "node scripts/make-samples.mjs",
    "gen": "node cli.mjs",
    "test": "node scripts/make-samples.mjs && node test-engine.mjs",
    "test:ui": "esbuild test-render.mjs --bundle --platform=node --format=esm --outfile=.test-render.built.mjs --external:jsdom --define:import.meta.env={} --jsx=automatic && node .test-render.built.mjs",
    "test:all": "npm test && npm run test:ui",
    "db:migrate": "node scripts/migrate.mjs",
    "test:db": "node test-db.mjs",
    "test:routes": "node scripts/make-samples.mjs && node test-routes.mjs",
    "db:seed": "node scripts/seed.mjs",
    "demo": "node scripts/make-samples.mjs && node demo.mjs",
    "revisao": "node scripts/make-samples.mjs && node revisao.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "docxtemplater": "^3.50.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.427.0",
    "pg": "^8.22.0",
    "pizzip": "^3.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "vite": "^5.4.0"
  }
}
